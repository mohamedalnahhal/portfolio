---
import { siteConfig } from "../config";
import AsciiText from "./AsciiText.astro";
import ProjectCarousel from "./ProjectCarousel.astro";
const hasProjects = siteConfig.projects && siteConfig.projects.length > 0;
---

{
  hasProjects && (
    <section id="projects" class="p-8 sm:p-12 md:p-16 lg:p-24">
      <div>
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-start">
          <div class="lg:col-span-4 lg:sticky lg:top-24 lg:h-fit lg:self-start">
            <h2 class="text-3xl sm:text-4xl md:text-5xl xl:text-7xl font-bold text-[var(--text-strong)]">
              <AsciiText text="Projects" />
            </h2>
            <div
              class="w-[75px] h-[5px] mt-2 rounded-full"
              style="background-color: var(--accent-color)"
            />
          </div>

          <div class="lg:col-span-8">
            <div class="space-y-8">
              {siteConfig.projects.map((project, index) => {
                return (
                  <div
                    class={`group relative p-4 sm:p-6 md:p-8 bg-[var(--surface-muted)] rounded-xl sm:rounded-2xl border border-[var(--border)] transition-all duration-300 ${
                      project.link
                        ? "hover:bg-[var(--surface-hover)] hover:shadow-xl hover:border-[var(--border-strong)] hover:-translate-y-1"
                        : ""
                    }`}
                  >
                      {project.link && (
                        <a
                          href={project.link}
                          target="_blank"
                          rel="noopener noreferrer"
                          aria-label={`View ${project.name} project`}
                          class="absolute inset-0 z-10 rounded-xl sm:rounded-2xl focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--accent-color)]"
                        />
                      )}
                      {project.link && (
                        <div class="absolute top-4 right-4 sm:top-6 sm:right-6 md:top-8 md:right-8 w-10 h-10 sm:w-11 sm:h-11 md:w-12 md:h-12 flex items-center justify-center bg-[var(--badge-bg)] rounded-full text-[var(--badge-text)] transition-all duration-300 group-hover:bg-[var(--pill-hover)]">
                          <svg
                            class="w-4 h-4 sm:w-4.5 sm:h-4.5 md:w-5 md:h-5 transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                          >
                            <path
                              stroke-linecap="round"
                              stroke-linejoin="round"
                              stroke-width="2"
                              d="M7 17L17 7M17 7H7M17 7V17"
                            />
                          </svg>
                        </div>
                      )}

                      <div class="space-y-4">
                        <div>
                          <span
                            class="text-sm font-mono"
                            style="color: var(--accent-color)"
                          >
                            0{index + 1}
                          </span>
                          <h3 class="text-xl sm:text-2xl font-bold text-[var(--text-strong)] mt-1">
                            {project.name}
                          </h3>
                        </div>

                        {project.screenshots && project.screenshots.length > 0 && (
                          <ProjectCarousel name={project.name} screenshots={project.screenshots} />
                        )}

                        <p
                          class={`text-base sm:text-lg text-[var(--text-body)] leading-relaxed ${project.link ? "pr-12 sm:pr-14 md:pr-16" : ""}`}
                        >
                          {project.description}
                        </p>

                        {project.skills && project.skills.length > 0 && (
                          <div class="flex flex-wrap gap-1.5 sm:gap-2 pt-2">
                            {project.skills.map((skill) => (
                              <span
                                class={`px-2.5 sm:px-3 py-1 sm:py-1.5 bg-[var(--badge-bg)] text-[var(--badge-text)] rounded-md sm:rounded-lg text-xs sm:text-sm font-medium transition-all duration-300 ${
                                  project.link ? "group-hover:bg-[var(--pill-hover)]" : ""
                                }`}
                              >
                                {skill}
                              </span>
                            ))}
                          </div>
                        )}
                      </div>
                  </div>
                );
              })}
            </div>
          </div>
        </div>
      </div>
    </section>
  )
}
